generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model cart_items_test {
  cart_item_id BigInt    @id @default(autoincrement())
  user_id      String
  product_id   Int?
  quantity     Int?      @default(1)
  added_at     DateTime? @default(now()) @db.Timestamp(6)
  products     products? @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model categories {
  category_id Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(100)
  image_url   String?
  featured    Boolean?     @default(false)
  sort_order  Int?         @default(0)
  parent_id   Int?
  parent      categories?  @relation("category_tree", fields: [parent_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  children    categories[] @relation("category_tree")
  products    products[]

  @@index([parent_id])
  @@schema("public")
}

model order_items {
  item_id      BigInt    @id @default(autoincrement())
  order_id     String?   @db.Uuid
  product_id   Int?
  quantity     Int?      @default(1)
  price        Decimal?  @db.Decimal(10, 2)
  product_name String?   @db.VarChar(200)
  orders       orders?   @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  products     products? @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

model orders {
  order_id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?            @db.Uuid
  status           String?            @default("pending")
  subtotal         Decimal?           @db.Decimal(10, 2)
  shipping         Decimal?           @db.Decimal(10, 2)
  tax              Decimal?           @db.Decimal(10, 2)
  total              Decimal?           @db.Decimal(10, 2)
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  payment_intent_id  String?            @unique
  payment_method     String?
  payment_status     String?            @default("unpaid")
  paid_at            DateTime?          @db.Timestamp(6)
  shipped_at         DateTime?          @db.Timestamp(6)
  delivered_at       DateTime?          @db.Timestamp(6)
  cancelled_at       DateTime?          @db.Timestamp(6)
  coupon_code        String?            @db.VarChar(50)
  discount           Decimal?           @default(0) @db.Decimal(10, 2)
  shipping_option    String?
  tracking_number    String?
  carrier            String?
  order_items        order_items[]
  users_test       users_test?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shipping_address shipping_address[]
  coupon_redemptions coupon_redemptions[]

  @@schema("public")
}

model brands {
  brand_id    Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(120)
  slug        String     @unique @db.VarChar(140)
  logo_url    String?
  description String?
  featured    Boolean?   @default(false)
  sort_order  Int?       @default(0)
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  products    products[]

  @@schema("public")
}

model collections {
  collection_id       Int                   @id @default(autoincrement())
  name                String                @db.VarChar(150)
  slug                String                @unique @db.VarChar(170)
  headline            String?
  description         String?
  image_url           String?
  active              Boolean?              @default(true)
  sort_order          Int?                  @default(0)
  starts_at           DateTime?             @db.Timestamp(6)
  expires_at          DateTime?             @db.Timestamp(6)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  collection_products collection_products[]

  @@schema("public")
}

model collection_products {
  id            Int         @id @default(autoincrement())
  collection_id Int
  product_id    Int
  sort_order    Int         @default(0)
  collections   collections @relation(fields: [collection_id], references: [collection_id], onDelete: Cascade, onUpdate: NoAction)
  products      products    @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([collection_id, product_id])
  @@index([product_id])
  @@schema("public")
}

model promotions {
  promotion_id Int       @id @default(autoincrement())
  headline     String    @db.VarChar(120)
  subhead      String?
  fine_print   String?
  badge        String?   @db.VarChar(40)
  image_url    String?
  link_url     String?   @db.VarChar(300)
  accent       String?   @default("sand") @db.VarChar(20)
  coupon_code  String?   @db.VarChar(50)
  active       Boolean?  @default(true)
  sort_order   Int?      @default(0)
  starts_at    DateTime? @db.Timestamp(6)
  expires_at   DateTime? @db.Timestamp(6)
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  @@schema("public")
}

model landing_sections {
  section_id Int       @id @default(autoincrement())
  type       String    @db.VarChar(50)
  title      String?   @db.VarChar(150)
  subtitle   String?   @db.VarChar(300)
  config     Json?
  position   Int       @default(0)
  active     Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@schema("public")
}

model product_images {
  id         Int       @id @default(autoincrement())
  product_id Int
  url        String
  sort_order Int       @default(0)
  is_primary Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  products   products  @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id])
  @@schema("public")
}

model product_questions {
  question_id Int       @id @default(autoincrement())
  product_id  Int?
  name        String    @db.VarChar(100)
  email       String    @db.VarChar(100)
  question    String
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  products        products?         @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)
  product_answers product_answers[]

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_reviews {
  review_id  Int       @id @default(autoincrement())
  product_id Int?
  name       String    @db.VarChar(100)
  email      String    @db.VarChar(100)
  title      String    @db.VarChar(200)
  review     String
  rating     Decimal     @db.Decimal(2, 1)
  created_at DateTime?   @default(now()) @db.Timestamp(6)
  user_id    String?     @db.Uuid
  verified   Boolean?    @default(false)
  products   products?   @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)
  users_test users_test? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@schema("public")
}

model products {
  product_id        Int                 @id @default(autoincrement())
  category_id       Int?
  name              String              @db.VarChar(200)
  description       String?
  price             Decimal             @db.Decimal(10, 2)
  stock             Int?                @default(0)
  avg_rating        Decimal?            @default(0) @db.Decimal(3, 2)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  image_url         String?
  brand_id          Int?
  brands            brands?             @relation(fields: [brand_id], references: [brand_id], onDelete: SetNull, onUpdate: NoAction)
  cart_items_test   cart_items_test[]
  collection_products collection_products[]
  order_items       order_items[]
  product_images    product_images[]
  product_questions product_questions[]
  product_reviews   product_reviews[]
  categories        categories?         @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  wishlist_test     wishlist_test[]

  @@schema("public")
}

model shipping_address {
  address_id  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id    String?   @db.Uuid
  first_name  String?
  last_name   String?
  email       String?
  phone       String?
  street      String?
  apartment   String?
  city        String?
  state       String?
  postal_code String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  orders      orders?   @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model users_test {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?
  role           String?          @default("customer")
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  email          String           @unique
  password       String
  orders                orders[]
  user_addresses        user_addresses[]
  password_reset_tokens password_reset_tokens[]
  coupon_redemptions    coupon_redemptions[]
  product_reviews       product_reviews[]
  refresh_tokens        refresh_tokens[]

  @@schema("public")
}

model wishlist_test {
  wishlist_item_id BigInt    @id @default(autoincrement())
  user_id          String
  product_id       Int
  added_at         DateTime? @default(now()) @db.Timestamp(6)
  products         products  @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_addresses {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String?     @db.Uuid
  type        String?
  first_name  String?
  last_name   String?
  company     String?
  country     String?
  street      String?
  apartment   String?
  city        String?
  state       String?
  postal_code String?
  phone       String?
  email       String?
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  is_default  Boolean?    @default(false)
  users_test  users_test? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, type], map: "unique_user_address_type")
  @@schema("public")
}

model password_reset_tokens {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String      @db.Uuid
  token_hash String      @unique
  expires_at DateTime    @db.Timestamp(6)
  used_at    DateTime?   @db.Timestamp(6)
  created_at DateTime?   @default(now()) @db.Timestamp(6)
  users_test users_test  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@schema("public")
}

model product_answers {
  id            Int               @id @default(autoincrement())
  question_id   Int
  answer        String
  answered_by   String?
  created_at    DateTime?         @default(now()) @db.Timestamp(6)
  product_questions product_questions @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model coupons {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String               @unique @db.VarChar(50)
  type               String               @db.VarChar(20)
  value              Decimal              @db.Decimal(10, 2)
  min_order          Decimal?             @db.Decimal(10, 2)
  usage_limit        Int?
  per_user_limit     Int?
  starts_at          DateTime?            @db.Timestamp(6)
  expires_at         DateTime?            @db.Timestamp(6)
  active             Boolean?             @default(true)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  coupon_redemptions coupon_redemptions[]

  @@schema("public")
}

model coupon_redemptions {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coupon_id         String      @db.Uuid
  order_id          String      @db.Uuid
  user_id           String?     @db.Uuid
  amount_discounted Decimal     @db.Decimal(10, 2)
  created_at        DateTime?   @default(now()) @db.Timestamp(6)
  coupons           coupons     @relation(fields: [coupon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders            orders      @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  users_test        users_test? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([coupon_id, order_id])
  @@schema("public")
}

model shipping_options {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @unique @db.VarChar(50)
  title      String    @db.VarChar(100)
  price      Decimal   @db.Decimal(10, 2)
  min_days   Int
  max_days   Int
  free_over  Decimal?  @db.Decimal(10, 2)
  active     Boolean?  @default(true)
  sort_order Int       @default(0)

  @@schema("public")
}

model refresh_tokens {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String     @db.Uuid
  token_hash String     @unique
  expires_at DateTime   @db.Timestamp(6)
  revoked_at DateTime?  @db.Timestamp(6)
  user_agent String?
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  users_test users_test @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@schema("public")
}
